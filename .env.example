# Folder di komputer yang berisi file yang akan diunggah
TARGET_FOLDERS=C:/path/ke/folder/file

# Tautan folder Google Drive tujuan (bisa URL lengkap atau Folder ID)
GDRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1AbCdEfGhIjKlMnOpQrStUvWxYz

# Jumlah tab paralel browser yang berjalan bersamaan (rekomendasi: 3 - 5)
MAX_WORKERS=3

# Jumlah file per batch per tab (rekomendasi: 20 - 50)
BATCH_SIZE=50

# Tindakan jika file sudah ada di Drive: 'keep_both' (simpan keduanya) atau 'replace' (ganti)
DUPLICATE_ACTION=keep_both

# Filter ekstensi (pisahkan koma, kosongkan jika ingin upload semua format)
FILE_EXTENSIONS=
